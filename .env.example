# URL pública do site (usada em canonical, Open Graph e sitemap)
VITE_SITE_URL=https://kimikamotors.vercel.app

# WhatsApp da loja, só dígitos com DDI e DDD
VITE_WHATSAPP_NUMERO=5515981857291

# Supabase (banco de veículos, login do painel e fotos).
# Em Project Settings → API Keys. Use a "Publishable key" (sb_publishable_...), que é pública.
# NUNCA coloque aqui a "Secret key" (sb_secret_...).
# Sem estas duas, o site usa o arquivo src/data/veiculos.ts e o painel fica em modo demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
